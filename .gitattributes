# ===========================================================================
#  PhytoScope — how git is to treat each kind of file
# ===========================================================================

# --- By default: git decides, and normalises line endings to LF ------------
*               text=auto eol=lf

# --- What must keep Windows line endings -----------------------------------
#  NSIS and cmd.exe will not read a script in LF. These files therefore leave
#  the repository in CRLF, on every system.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.nsi           text eol=crlf
*.nsh           text eol=crlf
*.ps1           text eol=crlf

# --- What must stay in LF whatever happens ---------------------------------
#  A shell script in CRLF fails with "bad interpreter: no such file".
*.sh            text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
*.py            text eol=lf
configure       text eol=lf

# --- Binary: never convert, never merge ------------------------------------
*.pdf           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.icns          binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.zip           binary
*.gz            binary
*.xz            binary
*.bz2           binary
*.7z            binary
*.uf2           binary
*.elf           binary
*.bin           binary
*.hex           binary
*.wav           binary
*.flac          binary
*.mp3           binary
*.ogg           binary
*.sf2           binary
*.p7s           binary
*.der           binary
*.p12           binary

# --- Certificates: text, but not to be merged ------------------------------
*.pem           text eol=lf -merge
*.crt           text eol=lf -merge

# --- Generated files: keep them out of the language statistics, and out of
#     the diff by default (C-45: never edited by hand, so their diff teaches
#     nothing).
pdf-src/assets/svg/*.svg        linguistic-documentation -diff linguist-generated=true
pdf-src/_*.html                 -diff linguist-generated=true
pdf-src/parts/A0b-codes.html    -diff linguist-generated=true
pdf-src/parts/A1-glossaire.html -diff linguist-generated=true
pdf-src/parts/A3-index.html     -diff linguist-generated=true
pdf-src/parts-carte/_*.html     -diff linguist-generated=true
src/phytoscope/sbom.cdx.json -diff linguist-generated=true

# --- Third-party code: out of the repository's language statistics ---------
#  Without this, GitHub announces that the project is written in C by
#  Playtronica.
sources/**                  linguist-vendored=true
sources/reverse/**              linguist-documentation=true

# --- Licence texts: recognised, but not counted as code --------------------
LICENSES/**                 linguist-documentation=true
LICENSE                     linguist-documentation=true

# --- What must not leave in a `git archive` --------------------------------
.github/            export-ignore
.ai/                export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
.editorconfig       export-ignore
.pre-commit-config.yaml export-ignore
CLAUDE.md           export-ignore
AGENTS.md           export-ignore
