#
# Ce fichier est PUBLIC : il sert à vérifier les paquets, jamais à
# en signer. La clé privée vit dans ~/.local/share/phytoscope-signature
# et ne doit JAMAIS être recopiée ici.
#
# Vérifier un paquet :
#     openssl cms -verify -binary -inform DER -in <paquet>.p7s \
#         -content <paquet> -certfile phytoscope-certificat.pem \
#         -noverify -out /dev/null
#
# Ce certificat est AUTO-SIGNÉ : il prouve l'intégrité et la
# continuité d'origine, il ne fait taire ni SmartScreen ni Gatekeeper.
# Voir AUTHENTICITE.txt auprès des paquets.

