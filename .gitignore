# ===========================================================================
#  PhytoScope — what must never enter the repository
# ===========================================================================
#  The repository is PUBLIC. Three families of thing are kept out of it:
#
#    1. secrets — the private signing key above all;
#    2. what we have no right to redistribute — books under copyright, paywalled
#       articles, manufacturers' datasheets, third-party repositories copied in;
#    3. what rebuilds itself — PDFs, packages, caches, environments.
#
#  Careful: .gitignore protects against git, not against a backup or an
#  archive of the directory. See certificate/README.md and SECURITY.md.
# ===========================================================================


# ###########################################################################
#  1. SECRETS — nothing in this block may ever be published
# ###########################################################################

# --- The private signing key -----------------------------------------------
#  It stays local. Its reference copy lives in
#  ~/.local/share/phytoscope-signature/ ; the one in certificate/ is a
#  working copy. The PUBLIC certificate is distributed — see the exception
#  further down.
certificate/phytoscope.key
certificate/*.key

# --- Keys and cryptographic material, wherever they are --------------------
*.key
*.pem
*.der
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
*.kdbx
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
.ssh/
secring.*

#  Exception: the PUBLIC X.509 certificate is meant to be distributed — it is
#  what lets anyone verify a signature. Re-allowed here by name.
!certificate/phytoscope-certificate.pem
!certificate/phytoscope.crt

# --- Application secrets, tokens, passwords --------------------------------
.env
.env.*
!.env.example
*.env
secrets.*
*secret*.json
*secrets*.yml
*secrets*.yaml
credentials
credentials.*
*.credentials
.netrc
.npmrc
.pypirc
.docker/config.json
.aws/
.azure/
.gcloud/
*token*.txt
*.token

# ###########################################################################
#  3. WHAT REBUILDS ITSELF
# ###########################################################################

# --- Books and packages produced -------------------------------------------
build/
!build/.gitkeep
dist/
out/
target/

# --- Installation packages, wherever they are ------------------------------
*.deb
*.rpm
*.msi
*.exe
*.pkg
*.dmg
*.run
*.snap
*.flatpak
*.appimage
*.AppImage
*.whl
*.egg
*.sdist
*.tar.gz
*.tar.bz2
*.tar.xz
*.tgz
*.zip
*.7z
*.rar
*.iso
#  ... but the third-party archives listed in the manifest are already
#  covered above, and a packaging template has to stay version-controlled:
!packaging/templates/**
!sources/schematics/**

# --- Signatures and publication checksums ----------------------------------
*.p7s
*.sig
*.sha256
*.sha512
*.md5


