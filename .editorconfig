# ===========================================================================
#  PhytoScope — editing conventions, for every editor
# ===========================================================================
#  This file exists for one precise reason: a Makefile recipe indented with
#  spaces is silently ignored by make, and a source file whose line endings
#  change from one machine to another produces differences that say nothing.
#  So both are fixed here.
# ===========================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 96

#  Makefiles require the tab: that is not a taste, it is the syntax.
[{Makefile,*.mk,makefile,GNUmakefile}]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.{html,css,svg,xml}]
indent_size = 2
#  A generated illustration is never edited by hand (C-45): we leave its
#  trailing whitespace alone, or every regeneration would show a difference.
trim_trailing_whitespace = false

[*.{c,h,cpp,hpp}]
indent_size = 4

[*.{json,cdx.json}]
indent_size = 2

[*.md]
#  In Markdown, two trailing spaces make a line break.
trim_trailing_whitespace = false

[*.{csv,tsv}]
trim_trailing_whitespace = false
insert_final_newline = true

#  These files are read by a strict "key = value" parse: nothing touches them
#  automatically.
[{VERSION,AUTHORS}]
trim_trailing_whitespace = false

#  The factory's Windows files must keep CRLF line endings, or NSIS and
#  cmd.exe will not read them.
[*.{bat,cmd,nsi,nsh}]
end_of_line = crlf

#  Third-party code keeps its own conventions: it is not ours.
[sources/**]
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = false
insert_final_newline = false

[LICENSES/**]
max_line_length = unset
trim_trailing_whitespace = false
