[Desktop Entry]
Type=Application
Version=1.0
Name=PhytoScope
GenericName=Écoute des signaux végétaux
GenericName[en]=Plant signal listening
Comment=Mesurer, écouter et enregistrer les signaux électriques d'une plante
Comment[en]=Measure, listen to and record the electrical signals of a plant
Exec=phytoscope %f
TryExec=phytoscope
Icon=phytoscope
Terminal=false
Categories=Science;Education;AudioVideo;Audio;
Keywords=plante;plant;biosignal;sonification;oscilloscope;MIDI;
MimeType=application/x-phytoscope-session;
StartupNotify=true
StartupWMClass=phytoscope
