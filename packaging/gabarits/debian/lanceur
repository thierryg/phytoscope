# ===========================================================================
#  PhytoScope — lanceur système (/usr/bin/phytoscope)
#
#  Le logiciel vit dans /usr/share/phytoscope avec son propre environnement
#  Python. Ce lanceur choisit l'interpréteur et rend un message utile quand
#  quelque chose manque — plutôt qu'une trace d'importation que personne ne
#  peut lire.
# ===========================================================================
CIBLE="/usr/share/phytoscope"
VENV="$CIBLE/venv"

if [ -x "$VENV/bin/python" ]; then
    PY="$VENV/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    #  L'environnement privé a disparu (nettoyage, /usr en lecture seule) :
    #  on tente le Python du système, qui suffit si les paquets y sont.
    PY="python3"
else
    echo "PhytoScope : aucun Python 3 trouvé. Installez « python3 »." >&2
    exit 1
fi

#  Un test d'importation avant de lancer : si Qt manque, mieux vaut une phrase
#  qu'un « ModuleNotFoundError » au milieu d'une pile d'appels.
if ! "$PY" -c "import PySide6" >/dev/null 2>&1; then
    echo "PhytoScope : PySide6 n'est pas installé dans $VENV." >&2
    echo "  Réparer :  sudo $VENV/bin/pip install -r $CIBLE/requirements.txt" >&2
    echo "  Ou bien :  sudo dpkg-reconfigure phytoscope   (Debian, Ubuntu, Mint)" >&2
    echo "  Diagnostic complet :  $PY $CIBLE/run.py --check" >&2
    exit 1
fi

exec "$PY" "$CIBLE/run.py" "$@"
