# ===========================================================================
#  PhytoScope — lanceur du paquet .app (macOS)
#
#  Le paquet embarque le logiciel et ses bibliothèques, mais PAS l'interpréteur
#  Python : Apple ne fournit plus de Python utilisable depuis macOS 12.3, et
#  redistribuer CPython depuis Linux donnerait un binaire non signé que
#  Gatekeeper refuserait de toute façon. On utilise donc le Python de
#  l'utilisateur, et l'on explique clairement s'il manque — en montrant une
#  vraie fenêtre, car un .app lancé depuis le Finder n'a pas de terminal où
#  écrire.
# ===========================================================================
set -u
ICI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESSOURCES="$(cd "$ICI/../Resources" && pwd)"

dire() {
    /usr/bin/osascript -e "display dialog \"$1\" buttons {\"OK\"} \
        with title \"PhytoScope\" with icon caution" >/dev/null 2>&1 || echo "$1" >&2
}

#  Ordre de préférence, et pourquoi il est ainsi :
#
#    1. l'interpréteur EMBARQUÉ dans le paquet — un CPython relogeable
#       (python-build-standalone). Il rend l'application utilisable sur une
#       machine nue, sans rien installer ni demander de privilèges (C-55) ;
#    2. le Python officiel de python.org, installé en « framework » ;
#    3. celui d'Apple, dans /usr/bin.
#
#  Homebrew est ÉCARTÉ. Un interpréteur posé sous /opt/homebrew ou
#  /usr/local/Cellar vient avec son propre chargeur dynamique et son propre
#  chemin de recherche : les roues de Qt, pyqtgraph et sounddevice s'y
#  installent, puis échouent à l'exécution sur des bibliothèques pourtant
#  présentes. Le défaut a été constaté sous Linux le 2026-09-18, et la même
#  mécanique existe sous macOS.
ecarte() {
    case "$(/usr/bin/python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null || echo "$1")" in
        /opt/homebrew/*|/usr/local/Cellar/*|/nix/store/*|/opt/conda/*|/opt/anaconda*/*) return 0 ;;
    esac
    return 1
}

trouver_python() {
    local p
    for p in "$RESSOURCES/python/bin/python3" \
             /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
             /usr/bin/python3; do
        [ -x "$p" ] || continue
        ecarte "$p" && continue
        #  Au moins 3.9, et capable de bâtir un environnement virtuel.
        "$p" -c 'import sys, venv; raise SystemExit(0 if sys.version_info >= (3,9) else 1)' \
            >/dev/null 2>&1 && { echo "$p"; return; }
    done
    echo ""
}

PY="$(trouver_python)"
if [ -z "$PY" ]; then
    dire "PhytoScope a besoin de Python 3.9 ou plus récent, et ce paquet n'en transporte pas.\n\nTéléchargez-le sur python.org (version « macOS 64-bit universal2 installer »), puis relancez PhytoScope.\n\nÉvitez la version Homebrew : elle ne voit pas les bibliothèques graphiques du système."
    exit 1
fi

#  L'environnement Python vit dans le dossier de l'utilisateur, pas dans le
#  paquet : un .app installé dans /Applications n'est pas inscriptible, et il
#  doit pouvoir servir plusieurs comptes.
VENV="$HOME/Library/Application Support/PhytoScope/venv"
REGLAGES="$HOME/Library/Application Support/PhytoScope/reglages.json"

#  La langue, à la première ouverture seulement. Un .pkg s'installe sans rien
#  demander — c'est ce qu'on attend de lui —, la question se pose donc ici,
#  avant que l'environnement ne soit bâti et avant toute autre fenêtre.
#
#  On DEMANDE, on ne devine pas : la contrainte C-31 interdit la détection
#  automatique de la locale, et `AppleLocale` dirait la langue du système, non
#  celle dans laquelle on veut travailler.
if [ ! -f "$REGLAGES" ]; then
    mkdir -p "$(dirname "$REGLAGES")"
    CHOIX="$(/usr/bin/osascript <<'FINAS' 2>/dev/null
set langues to {"Français", "English", "Español", "Português", "Italiano", ¬
    "Bahasa Indonesia", "Русский", "中文", "日本語", "한국어", "العربية"}
set retenue to choose from list langues ¬
    with title "PhytoScope" ¬
    with prompt "Choisissez votre langue — cette langue servira à PhytoScope." ¬
    default items {"Français"} without multiple selections allowed
if retenue is false then
    return ""
else
    return item 1 of retenue
end if
FINAS
)"
    case "$CHOIX" in
        "Français")         LANGUE="fr" ;;
        "English")          LANGUE="en" ;;
        "Español")          LANGUE="es" ;;
        "Português")        LANGUE="pt" ;;
        "Italiano")         LANGUE="it" ;;
        "Bahasa Indonesia") LANGUE="id" ;;
        "Русский")          LANGUE="ru" ;;
        "中文")              LANGUE="zh" ;;
        "日本語")            LANGUE="ja" ;;
        "한국어")            LANGUE="ko" ;;
        "العربية")          LANGUE="ar" ;;
        *)                  LANGUE="" ;;
    esac
    #  Écrit par l'outil du logiciel, qui sait fusionner et écrire de façon
    #  atomique. Pas de Python encore disponible ? La question se reposera à
    #  l'ouverture suivante, et le logiciel démarrera en français.
    if [ -n "$LANGUE" ] && [ -f "$RESSOURCES/app/ecrire_langue.py" ]; then
        "$PY" "$RESSOURCES/app/ecrire_langue.py" "$LANGUE" >/dev/null 2>&1 || true
    fi
fi
if [ ! -x "$VENV/bin/python" ]; then
    dire "Première ouverture : PhytoScope va préparer son environnement Python.\n\nCela prend une à deux minutes et ne se produira qu'une fois."
    mkdir -p "$(dirname "$VENV")"
    "$PY" -m venv "$VENV" || { dire "Création de l'environnement impossible."; exit 1; }
    if [ -d "$RESSOURCES/roues" ]; then
        "$VENV/bin/pip" install --quiet --no-index --find-links "$RESSOURCES/roues" \
            -r "$RESSOURCES/app/requirements.txt" 2>/dev/null \
        || "$VENV/bin/pip" install --quiet -r "$RESSOURCES/app/requirements.txt"
    else
        "$VENV/bin/pip" install --quiet -r "$RESSOURCES/app/requirements.txt"
    fi || { dire "Installation des bibliothèques impossible.\nVérifiez votre connexion et relancez."; exit 1; }
    "$VENV/bin/pip" install --quiet -r "$RESSOURCES/app/requirements-optionnel.txt" \
        >/dev/null 2>&1 || true

    #  Cache de bytecode. Le .app posé dans /Applications n'est pas
    #  inscriptible : sans ce cache, Python recompile à chaque démarrage les
    #  modules du paquet et jette le résultat. On le construit dans
    #  l'environnement de l'utilisateur, qui l'est, et une seule fois.
    "$VENV/bin/python" -m compileall -q "$VENV/lib" >/dev/null 2>&1 || true
    #  Les modules du paquet, eux, vont dans un cache à part : leur dossier
    #  est en lecture seule, d'où PYTHONPYCACHEPREFIX ci-dessous.
    PYTHONPYCACHEPREFIX="$(dirname "$VENV")/bytecode" \
        "$VENV/bin/python" -m compileall -q "$RESSOURCES/app" >/dev/null 2>&1 || true
fi

#  Le cache des modules du paquet vit à côté de l'environnement, parce que le
#  .app lui-même est en lecture seule.
export PYTHONPYCACHEPREFIX="$(dirname "$VENV")/bytecode"

exec "$VENV/bin/python" "$RESSOURCES/app/run.py" "$@"
